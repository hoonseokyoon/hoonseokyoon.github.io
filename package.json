{
  "name": "hoonseokyoon-personal-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsx scripts/generate-redirects.ts",
    "preview": "tsx scripts/serve-build.ts",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:browser": "npm run build && playwright test",
    "validate:content": "tsx scripts/validate-content.ts",
    "social-card": "tsx scripts/social-card.ts",
    "verify": "npm run check && npm run validate:content -- --release && npm test && npm run test:browser",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "overrides": {
    "cookie": "0.7.2"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.69.3",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@types/node": "^22.20.1",
    "prettier": "3.8.2",
    "prettier-plugin-svelte": "3.4.1",
    "svelte": "5.56.5",
    "svelte-check": "4.7.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
